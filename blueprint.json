{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/wp-admin/options-general.php?page=auto-sync-for-fb",
  "preferredVersions": {
    "php": "8.0",
    "wp": "latest"
  },
  "phpExtensionBundles": [
    "kitchen-sink"
  ],
  "steps": [
    {
      "step": "login",
      "username": "admin",
      "password": "password"
    },
    {
      "step": "installPlugin",
      "pluginZipFile": {
        "resource": "wordpress.org/plugins",
        "slug": "auto-sync-for-fb"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "setSiteOptions",
      "options": {
        "fb2wp_page_id": "109823475923841",
        "fb2wp_sync_interval": "hourly",
        "fb2wp_post_status": "publish",
        "fb2wp_token_expiry_info": "Permanent (Never Expiring)"
      }
    }
  ]
}
